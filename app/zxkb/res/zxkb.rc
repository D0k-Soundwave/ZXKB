#include <windows.h>
#include "resource.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "zxkb.manifest"
IDI_ON  ICON "zxkb.ico"
IDI_OFF ICON "zxkb_off.ico"

IDD_NAME DIALOGEX 0, 0, 220, 64
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOPMOST
CAPTION "ZXKB - save profile"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Name for this profile:", -1, 7, 8, 200, 10
    EDITTEXT        IDC_NAME, 7, 20, 206, 13, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "Save", IDOK, 109, 43, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 163, 43, 50, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     ZXKB_VERSION_MAJOR, ZXKB_VERSION_MINOR, 0, 0
PRODUCTVERSION  ZXKB_VERSION_MAJOR, ZXKB_VERSION_MINOR, 0, 0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904b0"
        BEGIN
            VALUE "CompanyName", "D0k"
            VALUE "FileDescription", "ZXKB keyboard lighting"
            VALUE "FileVersion", ZXKB_VERSION_STR
            VALUE "LegalCopyright", "Copyright 2026 D0k. GPL-3.0-or-later."
            VALUE "OriginalFilename", "ZXKB.exe"
            VALUE "ProductName", "ZXKB"
            VALUE "ProductVersion", ZXKB_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0809, 1200
    END
END
