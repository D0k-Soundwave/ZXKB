#include <windows.h>
#include "resource.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "zxkb.manifest"
IDI_ON  ICON "zxkb.ico"
IDI_OFF ICON "zxkb_off.ico"

IDD_FIRMWARE DIALOGEX 0, 0, 280, 214
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ZXKB - keyboard firmware"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_FW_INFO, 7, 8, 266, 10, SS_ENDELLIPSIS
    LTEXT           "", IDC_FW_FOLDER, 7, 24, 266, 10, SS_PATHELLIPSIS
    LISTBOX         IDC_FW_LIST, 7, 37, 266, 82, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    PUSHBUTTON      "Other file...", IDC_FW_BROWSE, 7, 124, 60, 14
    PUSHBUTTON      "Copy layout now", IDC_FW_COPYNOW, 71, 124, 65, 14
    PUSHBUTTON      "Layout backups...", IDC_FW_BACKUPS, 140, 124, 70, 14
    LTEXT           "", IDC_FW_STATUS, 7, 145, 266, 30
    CONTROL         "", IDC_FW_PROGRESS, "msctls_progress32", 0, 7, 177, 266, 10
    DEFPUSHBUTTON   "Install", IDC_FW_INSTALL, 169, 193, 50, 14
    PUSHBUTTON      "Close", IDCANCEL, 223, 193, 50, 14
END

IDD_LAYOUTCHECK DIALOGEX 0, 0, 360, 250
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ZXKB - check the key layout"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_LC_INFO, 7, 7, 346, 36
    LTEXT           "", IDC_LC_FILE, 7, 44, 346, 10, SS_PATHELLIPSIS
    CONTROL         "", IDC_LC_LIST, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 7, 57, 346, 162
    PUSHBUTTON      "Tick all", IDC_LC_ALL, 7, 229, 45, 14
    PUSHBUTTON      "Tick none", IDC_LC_NONE, 56, 229, 45, 14
    DEFPUSHBUTTON   "Put back the ticked ones", IDC_LC_APPLY, 155, 229, 95, 14
    PUSHBUTTON      "Keep the keyboard as it is", IDCANCEL, 254, 229, 99, 14
END

IDD_KBSETTINGS DIALOGEX 0, 0, 300, 286
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_VISIBLE
CAPTION "ZXKB - keyboard settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_KS_INFO, 7, 7, 286, 18
    GROUPBOX        "Game mode", -1, 7, 28, 286, 52
    AUTOCHECKBOX    "Game mode on", IDC_KS_GAME, 14, 40, 274, 10
    LTEXT           "While it is on, block:", -1, 14, 54, 70, 10
    AUTOCHECKBOX    "Alt+Tab", IDC_KS_ALTTAB, 86, 53, 50, 10
    AUTOCHECKBOX    "Alt+F4", IDC_KS_ALTF4, 140, 53, 50, 10
    AUTOCHECKBOX    "Windows keys", IDC_KS_WIN, 194, 53, 70, 10
    LTEXT           "Fn+Win switches it (or any key given ZXKB, Game mode on / off in Change keys).", -1, 14, 66, 274, 10
    LTEXT           "SOCD: of two opposite keys held, the last one pressed counts.", -1, 7, 86, 286, 10
    AUTOCHECKBOX    "A / D and W / S", IDC_KS_SOCD_WASD, 14, 98, 90, 10
    AUTOCHECKBOX    "Arrow keys", IDC_KS_SOCD_ARROWS, 108, 98, 80, 10
    LTEXT           "Debounce", -1, 7, 117, 50, 10
    CONTROL         "", IDC_KS_DEBOUNCE, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 56, 114, 160, 15
    EDITTEXT        IDC_KS_DEBOUNCE_VAL, 218, 115, 75, 13, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Raise it if a key types twice; lower means a press counts sooner.", -1, 14, 130, 279, 10
    LTEXT           "Lights off when idle for", -1, 7, 148, 80, 10
    COMBOBOX        IDC_KS_IDLE, 88, 146, 70, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "(a key press puts them back)", -1, 162, 148, 131, 10
    AUTOCHECKBOX    "While Fn is held, light the keys that do something on it", IDC_KS_LAYER, 7, 166, 220, 10
    CONTROL         "", IDC_KS_LAYER_C, "Button", BS_OWNERDRAW | WS_TABSTOP, 233, 163, 30, 15
    AUTOCHECKBOX    "N-key rollover (every key held counts)", IDC_KS_NKRO, 7, 184, 220, 10
    LTEXT           "Macro play", -1, 7, 202, 40, 10
    COMBOBOX        IDC_KS_MACRO, 50, 200, 60, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_KS_MACRO_MODE, 114, 200, 130, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    GROUPBOX        "Windows key repeat (all keyboards on this PC)", -1, 7, 220, 286, 44
    LTEXT           "Delay", -1, 14, 234, 40, 10
    CONTROL         "", IDC_KS_DELAY, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 50, 231, 70, 15
    EDITTEXT        IDC_KS_DELAY_VAL, 122, 232, 38, 13, ES_RIGHT | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Rate", -1, 164, 234, 20, 10
    CONTROL         "", IDC_KS_RATE, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 184, 231, 60, 15
    EDITTEXT        IDC_KS_RATE_VAL, 246, 232, 45, 13, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 189, 268, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 243, 268, 50, 14
END

IDD_MACROS DIALOGEX 0, 0, 300, 302
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_VISIBLE
CAPTION "ZXKB - macros"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_MC_INFO, 7, 7, 286, 18
    LISTBOX         IDC_MC_LIST, 7, 28, 286, 110, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    LTEXT           "The macro selected:", -1, 7, 144, 70, 10
    COMBOBOX        IDC_MC_PLAYEDBY, 80, 142, 213, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    EDITTEXT        IDC_MC_EDIT, 7, 156, 286, 36, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Text is typed; {Enter} taps a key; {Ctrl+C} a key with Ctrl; {Shift down} / {Shift up} hold and let go; {wait 250} waits 250 ms; {wait 200-300} a different time each run; {{ types {. US key positions (QMK).", -1, 7, 196, 286, 26
    PUSHBUTTON      "Record", IDC_MC_RECORD, 7, 226, 60, 14
    AUTOCHECKBOX    "Record waits", IDC_MC_WAITS, 71, 228, 60, 10
    PUSHBUTTON      "Clear", IDC_MC_CLEARONE, 133, 226, 40, 14
    DEFPUSHBUTTON   "Save to keyboard", IDC_MC_SAVE, 213, 226, 80, 14
    LTEXT           "Recorded waits vary by +/-", -1, 7, 246, 92, 10
    EDITTEXT        IDC_MC_VARY, 100, 244, 30, 13, ES_NUMBER | ES_RIGHT | WS_TABSTOP
    LTEXT           "", IDC_MC_VARY_NOTE, 134, 246, 159, 10
    LTEXT           "", IDC_MC_KB_LABEL, 7, 262, 240, 18
    COMBOBOX        IDC_MC_KB_SLOT, 250, 262, 43, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Import...", IDC_MC_IMPORT, 7, 284, 50, 14
    PUSHBUTTON      "Export...", IDC_MC_EXPORT, 61, 284, 50, 14
    PUSHBUTTON      "Close", IDCANCEL, 243, 284, 50, 14
END

IDD_REMAP DIALOGEX 0, 0, 250, 286
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_VISIBLE
CAPTION "ZXKB - change keys"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_RM_INFO, 7, 7, 236, 20
    AUTORADIOBUTTON "Press", IDC_RM_PRESS, 7, 30, 50, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Turn left", IDC_RM_LEFT, 60, 30, 60, 10
    AUTORADIOBUTTON "Turn right", IDC_RM_RIGHT, 124, 30, 60, 10
    CONTROL         "", IDC_RM_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOCOLUMNHEADER | WS_BORDER | WS_TABSTOP, 7, 43, 236, 179
    DEFPUSHBUTTON   "Set the selected keys", IDC_RM_ASSIGN, 109, 229, 80, 14
    PUSHBUTTON      "Close", IDCANCEL, 193, 229, 50, 14
    LTEXT           "", IDC_RM_KEPT, 7, 250, 236, 10
    PUSHBUTTON      "Put my key changes back", IDC_RM_REAPPLY, 7, 264, 110, 14
    PUSHBUTTON      "Forget my key changes", IDC_RM_FORGET, 121, 264, 100, 14
END

IDD_CAPS DIALOGEX 0, 0, 260, 170
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_VISIBLE
CAPTION "ZXKB - Caps Lock light"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "While Caps Lock is on, these keys show this light, over the effect and the key colours.", -1, 7, 7, 246, 18
    LTEXT           "Effect", -1, 7, 32, 50, 10
    COMBOBOX        IDC_CAPS_FX, 60, 30, 90, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Colours", -1, 7, 52, 50, 10
    CONTROL         "1", IDC_CAPS_C1, "Button", BS_OWNERDRAW | WS_TABSTOP, 60, 49, 30, 15
    CONTROL         "2", IDC_CAPS_C2, "Button", BS_OWNERDRAW | WS_TABSTOP, 96, 49, 30, 15
    LTEXT           "Speed", -1, 7, 72, 50, 10
    CONTROL         "", IDC_CAPS_SPEED, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 56, 69, 150, 15
    EDITTEXT        IDC_CAPS_SPEED_VAL, 208, 70, 45, 13, ES_RIGHT | ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Full brightness (whatever the brightness setting)", IDC_CAPS_FULL, 7, 90, 246, 12
    LTEXT           "", IDC_CAPS_KEYS, 7, 110, 60, 10
    PUSHBUTTON      "Use the keys selected in the preview", IDC_CAPS_USE_SEL, 68, 107, 130, 14
    PUSHBUTTON      "Caps Lock only", IDC_CAPS_ONLY, 202, 107, 51, 14
    PUSHBUTTON      "Starting keys (Tab, Q, Caps Lock, A, Caps Shift, \\)", IDC_CAPS_START, 68, 125, 185, 14
    DEFPUSHBUTTON   "OK", IDOK, 149, 149, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 203, 149, 50, 14
END

IDD_APPS DIALOGEX 0, 0, 310, 222
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ZXKB - Profiles by program"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_AP_INFO, 7, 7, 296, 26
    CONTROL         "", IDC_AP_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 7, 36, 296, 96
    LTEXT           "Program", -1, 7, 142, 40, 10
    COMBOBOX        IDC_AP_EXE, 50, 140, 170, 120, CBS_DROPDOWN | CBS_AUTOHSCROLL | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Browse...", IDC_AP_BROWSE, 226, 139, 77, 14
    LTEXT           "Profile", -1, 7, 160, 40, 10
    COMBOBOX        IDC_AP_PROFILE, 50, 158, 170, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Add / change", IDC_AP_SET, 226, 157, 77, 14
    PUSHBUTTON      "Remove the selected program", IDC_AP_REMOVE, 7, 180, 120, 14
    DEFPUSHBUTTON   "Close", IDOK, 253, 201, 50, 14
END

IDD_LOCKS DIALOGEX 0, 0, 310, 220
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ZXKB - Lock lights"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_LK_INFO, 7, 7, 296, 30
    LTEXT           "Caps Lock", -1, 7, 46, 50, 10
    COMBOBOX        331, 60, 44, 70, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    CONTROL         "1", 332, "Button", BS_OWNERDRAW | WS_TABSTOP, 136, 43, 26, 15
    CONTROL         "2", 333, "Button", BS_OWNERDRAW | WS_TABSTOP, 166, 43, 26, 15
    AUTOCHECKBOX    "Full brightness", 336, 200, 45, 100, 12
    LTEXT           "Speed", -1, 60, 64, 30, 10
    CONTROL         "", 334, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 88, 61, 160, 15
    EDITTEXT        335, 252, 62, 45, 13, ES_RIGHT | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Num Lock", -1, 7, 88, 50, 10
    COMBOBOX        341, 60, 86, 70, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    CONTROL         "1", 342, "Button", BS_OWNERDRAW | WS_TABSTOP, 136, 85, 26, 15
    CONTROL         "2", 343, "Button", BS_OWNERDRAW | WS_TABSTOP, 166, 85, 26, 15
    AUTOCHECKBOX    "Full brightness", 346, 200, 87, 100, 12
    LTEXT           "Speed", -1, 60, 106, 30, 10
    CONTROL         "", 344, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 88, 103, 160, 15
    EDITTEXT        345, 252, 104, 45, 13, ES_RIGHT | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Scroll Lock", -1, 7, 130, 50, 10
    COMBOBOX        351, 60, 128, 70, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    CONTROL         "1", 352, "Button", BS_OWNERDRAW | WS_TABSTOP, 136, 127, 26, 15
    CONTROL         "2", 353, "Button", BS_OWNERDRAW | WS_TABSTOP, 166, 127, 26, 15
    AUTOCHECKBOX    "Full brightness", 356, 200, 129, 100, 12
    LTEXT           "Speed", -1, 60, 148, 30, 10
    CONTROL         "", 354, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 88, 145, 160, 15
    EDITTEXT        355, 252, 146, 45, 13, ES_RIGHT | ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Caps Lock light on chosen keys...", IDC_LK_KEYS, 7, 177, 130, 14
    DEFPUSHBUTTON   "OK", IDOK, 199, 199, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 253, 199, 50, 14
END

IDD_NAME DIALOGEX 0, 0, 220, 64
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOPMOST
CAPTION "ZXKB - save profile"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Name for this profile:", -1, 7, 8, 200, 10
    EDITTEXT        IDC_NAME, 7, 20, 206, 13, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "Save", IDOK, 109, 43, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 163, 43, 50, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     ZXKB_VERSION_MAJOR, ZXKB_VERSION_MINOR, 0, 0
PRODUCTVERSION  ZXKB_VERSION_MAJOR, ZXKB_VERSION_MINOR, 0, 0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904b0"
        BEGIN
            VALUE "CompanyName", "D0k"
            VALUE "FileDescription", "ZXKB keyboard lighting"
            VALUE "FileVersion", ZXKB_VERSION_STR
            VALUE "LegalCopyright", "Copyright 2026 D0k. GPL-3.0-or-later."
            VALUE "OriginalFilename", "ZXKB.exe"
            VALUE "ProductName", "ZXKB"
            VALUE "ProductVersion", ZXKB_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0809, 1200
    END
END
