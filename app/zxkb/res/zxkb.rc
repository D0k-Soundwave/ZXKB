#include <windows.h>
#include "resource.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "zxkb.manifest"
IDI_ON  ICON "zxkb.ico"
IDI_OFF ICON "zxkb_off.ico"

IDD_FIRMWARE DIALOGEX 0, 0, 280, 214
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ZXKB - keyboard firmware"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_FW_INFO, 7, 8, 266, 10, SS_ENDELLIPSIS
    LTEXT           "", IDC_FW_FOLDER, 7, 24, 266, 10, SS_PATHELLIPSIS
    LISTBOX         IDC_FW_LIST, 7, 37, 266, 82, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    PUSHBUTTON      "Other file...", IDC_FW_BROWSE, 7, 124, 60, 14
    LTEXT           "", IDC_FW_STATUS, 7, 145, 266, 30
    CONTROL         "", IDC_FW_PROGRESS, "msctls_progress32", 0, 7, 177, 266, 10
    DEFPUSHBUTTON   "Install", IDC_FW_INSTALL, 169, 193, 50, 14
    PUSHBUTTON      "Close", IDCANCEL, 223, 193, 50, 14
END

IDD_REMAP DIALOGEX 0, 0, 250, 250
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_VISIBLE
CAPTION "ZXKB - change keys"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_RM_INFO, 7, 7, 236, 20
    CONTROL         "", IDC_RM_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOCOLUMNHEADER | WS_BORDER | WS_TABSTOP, 7, 30, 236, 192
    DEFPUSHBUTTON   "Set the selected keys", IDC_RM_ASSIGN, 109, 229, 80, 14
    PUSHBUTTON      "Close", IDCANCEL, 193, 229, 50, 14
END

IDD_CAPS DIALOGEX 0, 0, 260, 170
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_VISIBLE
CAPTION "ZXKB - Caps Lock light"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "While Caps Lock is on, these keys show this light, over the effect and the key colours.", -1, 7, 7, 246, 18
    LTEXT           "Effect", -1, 7, 32, 50, 10
    COMBOBOX        IDC_CAPS_FX, 60, 30, 90, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Colours", -1, 7, 52, 50, 10
    CONTROL         "1", IDC_CAPS_C1, "Button", BS_OWNERDRAW | WS_TABSTOP, 60, 49, 30, 15
    CONTROL         "2", IDC_CAPS_C2, "Button", BS_OWNERDRAW | WS_TABSTOP, 96, 49, 30, 15
    LTEXT           "Speed", -1, 7, 72, 50, 10
    CONTROL         "", IDC_CAPS_SPEED, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 56, 69, 150, 15
    LTEXT           "", IDC_CAPS_SPEED_VAL, 208, 72, 45, 10
    AUTOCHECKBOX    "Full brightness (whatever the brightness setting)", IDC_CAPS_FULL, 7, 90, 246, 12
    LTEXT           "", IDC_CAPS_KEYS, 7, 110, 60, 10
    PUSHBUTTON      "Use the keys selected in the preview", IDC_CAPS_USE_SEL, 68, 107, 130, 14
    PUSHBUTTON      "Caps Lock only", IDC_CAPS_ONLY, 202, 107, 51, 14
    PUSHBUTTON      "Starting keys (Tab, Q, Caps Lock, A, Caps Shift, \\)", IDC_CAPS_START, 68, 125, 185, 14
    DEFPUSHBUTTON   "OK", IDOK, 149, 149, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 203, 149, 50, 14
END

IDD_NAME DIALOGEX 0, 0, 220, 64
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOPMOST
CAPTION "ZXKB - save profile"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Name for this profile:", -1, 7, 8, 200, 10
    EDITTEXT        IDC_NAME, 7, 20, 206, 13, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "Save", IDOK, 109, 43, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 163, 43, 50, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     ZXKB_VERSION_MAJOR, ZXKB_VERSION_MINOR, 0, 0
PRODUCTVERSION  ZXKB_VERSION_MAJOR, ZXKB_VERSION_MINOR, 0, 0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904b0"
        BEGIN
            VALUE "CompanyName", "D0k"
            VALUE "FileDescription", "ZXKB keyboard lighting"
            VALUE "FileVersion", ZXKB_VERSION_STR
            VALUE "LegalCopyright", "Copyright 2026 D0k. GPL-3.0-or-later."
            VALUE "OriginalFilename", "ZXKB.exe"
            VALUE "ProductName", "ZXKB"
            VALUE "ProductVersion", ZXKB_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0809, 1200
    END
END
